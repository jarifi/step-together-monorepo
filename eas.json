{
  "cli": {
    "version": ">= 16.23.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      }
    },
    "preview": {
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      },
      "env": {
        "APP_ENV": "preview",
        "API_BASE_URL": "https://api.step-together.at/api/v1"
      }
    },
    "production": {
      "autoIncrement": "version",
      "android": {
        "buildType": "app-bundle"
      },
      "env": {
        "APP_ENV": "production",
        "API_BASE_URL": "https://api.step-together.at/api/v1"
      }
    }
  },
  "submit": {
    "production": {}
  }
}
