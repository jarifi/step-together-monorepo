#@baseUrl = http://91.99.231.235:3000/api/v1
@baseUrl = http://localhost:3000/api/v1

### 1. Login to Get Access Token
# @name login
POST {{baseUrl}}/auth/login
Content-Type: application/json

{
    "email": "user1@bfi.at",
    "password": "StrongPassword123" 
}

### 1.1 Login to Get Access Token (Charlie)
# @name login
POST {{baseUrl}}/auth/login
Content-Type: application/json

{
    "email": "charlie@example.com",
    "password": "StrongPassword123" 
}

### 1.2 NEGATIVE TEST: Change Password with WRONG Old Password
POST {{baseUrl}}/auth/change_password
Authorization: Bearer {{login.response.body.accessToken}}
Content-Type: application/json

{
    "old_password": "ThisIsNotTheRightPassword",
    "new_password": "NewStrongPassword456" 
}

### 1.3 POSITIVE TEST: Change Password Successfully
POST {{baseUrl}}/auth/change_password
Authorization: Bearer {{login.response.body.accessToken}}
Content-Type: application/json

{
    "old_password": "NewStrongPassword456",
    "new_password": "StrongPassword123" 
}

### 2. Get All Users Using Access Token
GET {{baseUrl}}/users/?skip=0&limit=200
Authorization: Bearer {{login.response.body.accessToken}}

### 2.1 Get Single User Using Access Token
GET {{baseUrl}}/users/1
Authorization: Bearer {{login.response.body.accessToken}}

### 2.2. Create a New User (POST /api/v1/users/)
POST {{baseUrl}}/users/
Authorization: Bearer {{login.response.body.accessToken}}
Content-Type: application/json

{
    "email": "britney1211@example.com",
    "password": "StrongPassword123",
    "passwordConfirm": "StrongPassword123",
    "name": "Britney Spears",
    "stepLength": 0.75
}

### 2.3. Update an Existing User (PUT /api/v1/users/{user_id})
PUT {{baseUrl}}/users/1
Authorization: Bearer {{login.response.body.accessToken}}
Content-Type: application/json

{
    "email": "aliceup@example.com",
    "name": "AliceUp CuperUp",
    "stepLength": 0.95
}

### 2.4 Get User Dashboard Init
GET {{baseUrl}}/users/user/dashboard/init
Authorization: Bearer {{login.response.body.accessToken}}

### 2.5 Delete a User
DELETE {{baseUrl}}/users/1
Authorization: Bearer {{login.response.body.accessToken}}

### 3. Get All Teams Using Access Token
GET {{baseUrl}}/teams/
Authorization: Bearer {{login.response.body.accessToken}}

### 3.1 Create a New Team (POST /api/v1/teams/)
POST {{baseUrl}}/teams/
Authorization: Bearer {{login.response.body.accessToken}}
Content-Type: application/json

{
    "name": "Team TEST"
}

### 3.2 Get All Team Members from Team Challenge
GET {{baseUrl}}/teams/members/active_challenge/1/1
Authorization: Bearer {{login.response.body.accessToken}}

### 3.3 Add user to team
POST {{baseUrl}}/teams/join_team/20
Authorization: Bearer {{login.response.body.accessToken}}
Content-Type: application/json

{
    "user_id": 15
}

### 3.4 Update a Team (PUT /api/v1/teams/1)
PUT {{baseUrl}}/teams/1
Authorization: Bearer {{login.response.body.accessToken}}
Content-Type: application/json

{
    "name": "Team TEST1"
}

### 4. Get All Team Members Using Access Token
GET {{baseUrl}}/team_members
Authorization: Bearer {{login.response.body.accessToken}}

### 4.1 Get Team Member by ID
GET {{baseUrl}}/team_members/1
Authorization: Bearer {{login.response.body.accessToken}}

### 4.2 Get Team Members by Team
GET {{baseUrl}}/team_members/team/1
Authorization: Bearer {{login.response.body.accessToken}}

### 4.3 Create a New Team Member
POST {{baseUrl}}/team_members/
Authorization: Bearer {{login.response.body.accessToken}}
Content-Type: application/json

{
    "teamId": 2
}

### 4.4 Get All Members for Team 1 with name
GET {{baseUrl}}/teams/2/members
Authorization: Bearer {{login.response.body.accessToken}}

### 5. Get All Challenges Using Access Token
GET {{baseUrl}}/challenges/
Authorization: Bearer {{login.response.body.accessToken}}

### 5.1 Create a New Challenge (POST /api/v1/challenges/) 
POST {{baseUrl}}/challenges/
Authorization: Bearer {{login.response.body.accessToken}}
Content-Type: application/json

{
    "name": "Another Nice Challenge",
    "startLocation": "Liverpool", 
    "targetLocation": "London", 
    "distance": 300.0, 
    "startDate": "2025-05-01T00:00:00", 
    "endDate": "2025-06-01T00:00:00", 
    "teamId": 2,
    "creatorId": 1,
    "state": "incoming"  
}

### 5.2 Get Single Challenge
GET {{baseUrl}}/challenges/2
Authorization: Bearer {{login.response.body.accessToken}}

### 5.3 Delete a Challenge
DELETE {{baseUrl}}/challenges/1
Authorization: Bearer {{login.response.body.accessToken}}

### 5.4 Update a Challenge (PUT /api/v1/challenges/20) 
PUT {{baseUrl}}/challenges/2
Authorization: Bearer {{login.response.body.accessToken}}
Content-Type: application/json

{
    "name": "Another Nice Challenge1",
    "startLocation": "Liverpool1", 
    "targetLocation": "London1", 
    "distance": 500.0, 
    "startDate": "2026-02-05T13:00:00", 
    "endDate": "2026-02-05T13:48:00", 
    "teamId": 2,
    "creatorId": 1,
    "state": "closed"  
}

### 5.5 Get Teams with total steps for a Challenge
GET {{baseUrl}}/challenges/1/teams
Authorization: Bearer {{login.response.body.accessToken}}

### 5.6 Get Teams with total steps for a Challenge
GET {{baseUrl}}/challenges/me/history
Authorization: Bearer {{login.response.body.accessToken}}

### 6. Get All Challenge_progresses Using Access Token
GET {{baseUrl}}/challenge_progress/
Authorization: Bearer {{login.response.body.accessToken}}

### 7. Get All Step_logs Using Access Token
GET {{baseUrl}}/step_logs/
Authorization: Bearer {{login.response.body.accessToken}}

### 8. Get Step_logs by User Using Access Token
GET {{baseUrl}}/step_logs/user/1
Authorization: Bearer {{login.response.body.accessToken}}

### 9. Create a New Step_log (POST /api/v1/step_logs/)
POST {{baseUrl}}/step_logs/
Content-Type: application/json
Authorization: Bearer {{login.response.body.accessToken}}

{
  "challengeId": 10,
  "teamId": 3,
  "date": "2025-08-06T08:00:00",
  "numberOfSteps": 12000
}

### 10. Admin Update a Step_log
PUT {{baseUrl}}/step_logs/1
Content-Type: application/json
Authorization: Bearer {{login.response.body.accessToken}}

{
  "numberOfSteps": 15000
}

### 11. User Update a Step_log
PUT {{baseUrl}}/step_logs?step_log_id=1
Content-Type: application/json
Authorization: Bearer {{login.response.body.accessToken}}

{
  "numberOfSteps": 20000
}

### 12. Get Step_logs from Specific Week
GET {{baseUrl}}/step_logs/challenge/1/user/1?from=2025-08-10&to=2025-08-17
Content-Type: application/json
Authorization: Bearer {{login.response.body.accessToken}}

### 13. Create a Ticket
POST {{baseUrl}}/tickets/
Authorization: Bearer {{login.response.body.accessToken}}
Content-Type: application/json

{
    "title": "Cannot login to app"
}

### 13.1 Get All Tickets
GET {{baseUrl}}/tickets
Authorization: Bearer {{login.response.body.accessToken}}

### 13.2 Get Single Ticket
GET {{baseUrl}}/tickets/1
Authorization: Bearer {{login.response.body.accessToken}}

### 13.3 Add Message to Ticket
POST {{baseUrl}}/tickets/2/messages
Authorization: Bearer {{login.response.body.accessToken}}
Content-Type: application/json

{

    "message": "I keep getting a login error when trying to sign in."
}

### 13.4 List Messages for Ticket
GET {{baseUrl}}/tickets/1/messages
Authorization: Bearer {{login.response.body.accessToken}}

### 13.5 Update Ticket State
PUT {{baseUrl}}/tickets/1
Authorization: Bearer {{login.response.body.accessToken}}
Content-Type: application/json

{
    "state": "closed"
}